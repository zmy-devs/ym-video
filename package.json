{
  "name": "ym-video-workspace",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22.21.1",
    "pnpm": ">=11.20.0 <12"
  },
  "volta": {
    "node": "22.21.1"
  },
  "scripts": {
    "dev": "pnpm run dev:desktop",
    "dev:desktop": "pnpm --filter @ym-video/desktop run dev",
    "dev:mobile": "pnpm --filter @ym-video/mobile run dev",
    "setup:desktop": "pnpm --filter @ym-video/desktop run setup:native",
    "start": "pnpm --filter @ym-video/desktop run start",
    "typecheck": "pnpm -r run typecheck",
    "typecheck:desktop": "pnpm --filter @ym-video/desktop run typecheck",
    "typecheck:mobile": "pnpm --filter @ym-video/mobile run typecheck",
    "check": "pnpm run typecheck",
    "check:mobile": "pnpm --filter @ym-video/mobile run check",
    "build": "pnpm run build:desktop",
    "build:desktop": "pnpm --filter @ym-video/desktop run build",
    "build:unpack": "pnpm --filter @ym-video/desktop run build:unpack",
    "build:win": "pnpm --filter @ym-video/desktop run build:win",
    "build:mobile": "pnpm --filter @ym-video/mobile run build",
    "prebuild:mobile": "pnpm --filter @ym-video/mobile run prebuild",
    "android": "pnpm --filter @ym-video/mobile run android",
    "ios": "pnpm --filter @ym-video/mobile run ios",
    "release:desktop": "pnpm --filter @ym-video/desktop run release",
    "release:mobile": "pnpm --filter @ym-video/mobile run release"
  }
}
