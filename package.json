{
  "name": "ym-video-workspace",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22.21.1",
    "pnpm": ">=11.20.0 <12"
  },
  "volta": {
    "node": "22.21.1"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @ym-video/admin --filter @ym-video/api run dev",
    "dev:client:desktop": "pnpm --filter @ym-video/web run dev:desktop",
    "dev:client:mobile": "pnpm --filter @ym-video/web run dev:mobile",
    "typecheck:client": "pnpm --filter @ym-video/web run typecheck",
    "test:client": "pnpm --filter @ym-video/web run test",
    "test:desktop": "pnpm --filter @ym-video/desktop run test",
    "dev:desktop": "pnpm --filter @ym-video/desktop run dev",
    "dev:android": "pnpm --filter @ym-video/mobile run dev",
    "dev:api": "pnpm --filter @ym-video/api run dev",
    "migrate:api": "pnpm --filter @ym-video/api run db:migrate:local",
    "typecheck:api": "pnpm --filter @ym-video/api run typecheck",
    "build:api": "pnpm --filter @ym-video/api run build",
    "test:api": "pnpm --filter @ym-video/api run test",
    "start": "pnpm --filter @ym-video/desktop run start",
    "typecheck": "pnpm -r run typecheck",
    "typecheck:desktop": "pnpm --filter @ym-video/desktop run typecheck",
    "typecheck:mobile": "pnpm --filter @ym-video/mobile run typecheck",
    "check": "pnpm run typecheck",
    "build": "pnpm run build:desktop",
    "build:desktop": "pnpm --filter @ym-video/desktop run build",
    "build:unpack": "pnpm --filter @ym-video/desktop run build:unpack",
    "build:win": "pnpm --filter @ym-video/desktop run build:win",
    "build:android": "pnpm --filter @ym-video/mobile run build",
    "release:desktop": "pnpm --filter @ym-video/desktop run release",
    "release:android": "pnpm --filter @ym-video/mobile run release",
    "dev:admin": "pnpm --filter @ym-video/admin run dev",
    "typecheck:admin": "pnpm --filter @ym-video/admin run typecheck",
    "build:admin": "pnpm --filter @ym-video/admin run build",
    "preview:admin": "pnpm --filter @ym-video/admin run preview",
    "test:admin": "pnpm --filter @ym-video/admin run test"
  }
}
