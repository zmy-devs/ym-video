{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ym-video-api-local",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-12",
  "compatibility_flags": ["nodejs_compat"],
  "dev": { "port": 8788 },
  "upload_source_maps": true,
  "assets": {
    "directory": ".assets",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*", "/admin", "/admin/*"],
  },
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "secrets": { "required": ["BETTER_AUTH_SECRET"] },
  "vars": {
    "BETTER_AUTH_URL": "http://127.0.0.1:8788",
    "WEB_ORIGINS": "http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,http://localhost:3002,http://127.0.0.1:3002,http://localhost:4174",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ym-video-auth-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 60, "period": 60 },
    },
  ],
  "env": {
    "production": {
      "name": "ym-video-api",
      "workers_dev": false,
      "routes": [
        {
          "pattern": "ym-video.zhangmingyang.dpdns.org",
          "custom_domain": true,
        },
      ],
      "secrets": { "required": ["BETTER_AUTH_SECRET"] },
      "vars": {
        "BETTER_AUTH_URL": "https://ym-video.zhangmingyang.dpdns.org",
        "WEB_ORIGINS": "https://ym-video.zhangmingyang.dpdns.org",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "ym-video-auth",
          "database_id": "e0cf4d87-2e17-4a11-aa27-f7dae76b5629",
          "migrations_dir": "migrations",
        },
      ],
      "ratelimits": [
        {
          "name": "AUTH_RATE_LIMITER",
          "namespace_id": "1003",
          "simple": { "limit": 60, "period": 60 },
        },
      ],
    },
  },
}
