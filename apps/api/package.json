{
  "name": "@ym-video/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "volta": {
    "extends": "../../package.json"
  },
  "scripts": {
    "dev": "pnpm --filter @ym-video/web run build && wrangler dev --local",
    "types": "wrangler types",
    "typecheck": "pnpm run types && tsc --noEmit",
    "build": "pnpm --filter @ym-video/web run build && pnpm run typecheck && wrangler deploy --dry-run --outdir dist",
    "test": "pnpm run build && node --test tests/*.test.mjs",
    "db:generate": "drizzle-kit generate",
    "db:schema": "node scripts/generate-auth-schema.mjs",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "deploy": "pnpm --filter @ym-video/web run build && wrangler deploy --env production"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.10",
    "@better-auth/expo": "1.7.10",
    "better-auth": "1.7.10",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.7"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "drizzle-kit": "0.31.11",
    "miniflare": "5.20261012.1-beta",
    "typescript": "5.9.2",
    "wrangler": "4.151.1"
  }
}
